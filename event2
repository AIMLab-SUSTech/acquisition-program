#  3. 主逻辑 (精简版)
# =========================================================
class LogicWindow(ModernUI):
    def __init__(self):
        super().__init__()
        sys.excepthook = self.handle_exception
        
        # 替换 UI 里的 Label 为图像控件
        self.image_view = FastImageView()
        # 清除旧 layout 并添加新控件
        if self.image_area.layout(): 
            QWidget().setLayout(self.image_area.layout()) 
        layout = QVBoxLayout(self.image_area)
        layout.setContentsMargins(0,0,0,0)
        layout.addWidget(self.image_view)

        # 核心变量
        self.camera = None
        self.motion = None
        
        # 数据缓存 (使用 self 挂载，防止 scan_step 找不到)
        self.dp = [] 
        self.pos_x = []
        self.pos_y = []
        
        self.save_dir = "D:/Data" # 默认建议路径
        self.save_dir_edit.setText("please change this to your own path")
        self.dark_frame = None

        # 定时器
        self.timer = QTimer()
        self.timer.timeout.connect(self.update_frame)

        # 信号绑定
        self.bind_signals()

    def bind_signals(self):
        # 硬件
        self.btn_open_cam.clicked.connect(lambda: self.load_device('camera'))
        self.btn_connect_stage.clicked.connect(lambda: self.load_device('stage'))
        
        # 操作
        self.btn_live.clicked.connect(self.toggle_live)
        self.btn_cap.clicked.connect(self.start_scan)
        self.btn_save.clicked.connect(self.on_manual_save)
        self.btn_browse.clicked.connect(self.select_folder)
        self.btn_show_path.clicked.connect(self.preview_scan_path)
        self.btn_center.clicked.connect(self.auto_center)
        self.exposure_spin.valueChanged.connect(self.update_exposure)

        # 位移台
        w = self.stage_widget
        w.btn_up.clicked.connect(lambda: self.move_stage(0, 1, rel=True))
        w.btn_down.clicked.connect(lambda: self.move_stage(0, -1, rel=True))
        w.btn_left.clicked.connect(lambda: self.move_stage(1, -1, rel=True))
        w.btn_right.clicked.connect(lambda: self.move_stage(1, 1, rel=True))
        w.btn_go.clicked.connect(lambda: self.move_stage(0, 0, rel=False))
        w.btn_zero.clicked.connect(self.zero_stage)

        self.image_view.mouse_hover_signal.connect(self.on_mouse_hover)

    # --- 日志系统 ---
    def log_info(self, msg): self.log(msg, "#2196F3", "ℹ️")
    def log_success(self, msg): self.log(msg, "#4CAF50", "✅")
    def log_warning(self, msg): self.log(msg, "#FF9800", "⚠️")
    def log_error(self, msg): self.log(msg, "#F44336", "❌")

    def log(self, msg, color, icon):
        t = time.strftime("%H:%M:%S")
        self.txt_log.append(f"<span style='color:{color}'><b>[{t}]</b> {icon} {msg}</span>")
        self.txt_log.verticalScrollBar().setValue(self.txt_log.verticalScrollBar().maximum())

    def handle_exception(self, etype, evalue, tb):
        err = "".join(traceback.format_exception(etype, evalue, tb))
        print(err)
        self.log_error(f"系统错误: {evalue}")

    # --- 硬件加载通用逻辑 ---
    def load_device(self, dtype):
        name = self.combo_camera.currentText() if dtype == 'camera' else self.combo_stage.currentText()
        btn = self.btn_open_cam if dtype == 'camera' else self.btn_connect_stage
        
        self.log_info(f"正在加载 {dtype}: {name}...")
        btn.setEnabled(False)
        
        self.loader = DeviceLoader(dtype, name)
        self.loader.finished_signal.connect(lambda s, r: self.on_loaded(dtype, s, r, btn))
        self.loader.start()

    def on_loaded(self, dtype, success, result, btn):
        btn.setEnabled(True)
        if not success:
            self.log_error(f"加载失败: {result}")
            return
            
        if dtype == 'camera':
            self.camera = result
            self.update_exposure()
            # 获取位深用于计算饱和
            try:
                self.bit_depth = int(getattr(result, 'bit_depth', 16))
            except: self.bit_depth = 16
            self.sat_val = (1 << self.bit_depth) - 1
            btn.setStyleSheet("background:#4CAF50;color:white;")
            self.log_success(f"相机就绪 ({self.bit_depth}-bit)")
        else:
            self.motion = result
            self.sync_pos()
            btn.setText("已连接")
            self.log_success("位移台就绪")

    # --- 图像刷新 (核心循环) ---
    def update_frame(self):
        if not self.camera: return
        try:
            # === VSY 相机特殊处理 ===
            # 必须在每次采集前调用 start
            if self.camera.__class__.__name__ == "NewVSYCamera":
                self.camera.start_acquisition()

            # 1. 采集 & 裁剪
            img = self.camera.read_newest_image()
            if img is None: return
            
            roi = self.crop_image(img)
            
            # 2. 统计信息 (最大值)
            gmax = np.max(roi)
            self.line_global_max.setText(str(gmax))
            style = "color:red;background:#fee;" if gmax >= self.sat_val else "color:green;background:#eee;"
            self.line_global_max.setStyleSheet(style + "font-weight:bold;")

            # 3. 显示 (Log 变换只在勾选时运算，节省 CPU)
            if self.chk_log.isChecked():
                # 转换 float32 运算 -> log -> 归一化
                img_f = roi.astype(np.float32)
                disp = (np.log1p(img_f) / np.log1p(self.sat_val) * self.sat_val).astype(np.uint16)
                self.image_view.update_image(disp, self.chk_mask.isChecked())
            else:
                self.image_view.update_image(roi, self.chk_mask.isChecked())
                
        except Exception as e:
            # 实时流偶尔报错不弹窗，避免卡死
            print(f"Frame Error: {e}")

    def crop_image(self, img):
        h, w = img.shape
        try:
            tw, th = int(self.roi_w.text()), int(self.roi_h.text())
            ox, oy = int(self.off_x.text()), int(self.off_y.text())
        except: tw, th, ox, oy = 1024, 1024, 0, 0
        
        # 简单的中心裁剪逻辑
        cx, cy = w//2 + ox, h//2 + oy
        x1 = max(0, cx - tw//2)
        y1 = max(0, cy - th//2)
        x2 = min(w, x1 + tw)
        y2 = min(h, y1 + th)
        
        return img[int(y1):int(y2), int(x1):int(x2)]

    # --- 功能函数 ---
    def toggle_live(self):
        if not self.camera: return
        if self.timer.isActive():
            self.timer.stop()
            self.btn_live.setText("👁 启动")
            self.btn_live.setStyleSheet("background:#27ae60;color:white;font-weight:bold;")
        else:
            self.timer.start(50) # 20fps，老电脑跑得动
            self.btn_live.setText("⬛ 停止")
            self.btn_live.setStyleSheet("background:#7f8c8d;color:white;font-weight:bold;")

    def update_exposure(self):
        if self.camera: 
            try:
                self.camera.set_ex_time(self.exposure_spin.value()/1000.0)
            except: pass

    def on_mouse_hover(self, x, y, val):
        if val is not None:
            self.line_mouse_val.setText(str(val))

    def auto_center(self):
        if not self.camera: return
        
        # VSY 特殊处理
        if self.camera.__class__.__name__ == "NewVSYCamera":
            self.camera.start_acquisition()
            
        img = self.camera.read_newest_image()
        if img is None: return
        
        mask = img > (np.mean(img) + 3*np.std(img))
        if np.sum(mask) == 0: 
            self.log_warning("图像太暗，无法对准")
            return
            
        y_idx, x_idx = np.indices(img.shape)
        total = np.sum(img[mask])
        cx = np.sum(x_idx[mask] * img[mask]) / total
        cy = np.sum(y_idx[mask] * img[mask]) / total
        
        h, w = img.shape
        self.off_x.setText(str(int(cx - w/2)))
        self.off_y.setText(str(int(cy - h/2)))
        self.log_success(f"自动对准完成: Offset ({self.off_x.text()}, {self.off_y.text()})")
        self.update_frame() # 刷新一次看效果

    # --- 位移台控制 ---
    def move_stage(self, logical_axis, val, rel=True):
        """
        logical_axis: 0=Up/Down(Y), 1=Left/Right(X)
        val: 方向 或 绝对值
        """
        if not self.motion: return
        
        w = self.stage_widget
        swap = w.check_swap.isChecked()
        inv = [w.check_inv_y.isChecked(), w.check_inv_x.isChecked()] 
        
        try:
            if rel:
                step = w.step_spin.value()
                dist = val * step
                # 逻辑轴转物理轴
                idx = 0 if logical_axis == 0 else 1
                if inv[idx]: dist *= -1
                phys_axis = 1 if (idx==0 and not swap) or (idx==1 and swap) else 0
                self.motion.move_by(dist, axis=phys_axis)
            else:
                # 绝对移动
                tx, ty = float(w.target_x.text()), float(w.target_y.text())
                ax_x = 1 if swap else 0
                ax_y = 0 if swap else 1
                if hasattr(self.motion, 'move_to'):
                    self.motion.move_to(tx, axis=ax_x)
                    self.motion.move_to(ty, axis=ax_y)
            
            self.sync_pos()
            
        except Exception as e:
            self.log_error(f"移动失败: {e}")

    def sync_pos(self):
        if not self.motion: return
        try:
            if hasattr(self.motion, 'get_position'):
                x, y = self.motion.get_position(0), self.motion.get_position(1)
            elif hasattr(self.motion, 'xps'): # NewPort 特殊
                 # 假设 Group3=X, Group4=Y
                 x = self.motion.xps.get_stage_position('Group3.Pos')
                 y = self.motion.xps.get_stage_position('Group4.Pos')
            else:
                x, y = 0, 0
                
            self.stage_widget.lbl_x.setText(f"X: {x:.3f}")
            self.stage_widget.lbl_y.setText(f"Y: {y:.3f}")
            
        except: pass

    def zero_stage(self):
        if self.motion and hasattr(self.motion, 'move_to'):
            try:
                self.motion.move_to(0,0)
                self.motion.move_to(0,1)
                self.sync_pos()
                self.log_info("已回零")
            except: pass

    # --- 扫描与保存 ---
    def confirm_directory(self):
        d = self.save_dir_edit.text()
        if "please change" in d or not os.path.exists(d):
            if not self.select_folder(): return False
        self.save_dir = self.save_dir_edit.text()
        return True

    def select_folder(self):
        d = QFileDialog.getExistingDirectory(self, "选择保存路径")
        if d: 
            self.save_dir = d
            self.save_dir_edit.setText(d)
            return True
        return False

    def preview_scan_path(self):
        try:
            from Scanner import Scanner
            mode_map = {"矩形": "rectangle", "圆形": "round", "螺旋": "fermat"}
            mode = mode_map.get(self.combo_scan_mode.currentText(), "round")
            
            rx, ry = float(self.scan_range_x.text()), float(self.scan_range_y.text())
            step = float(self.scan_step.text())
            
            self.scanner = Scanner(step=step, scan_range_x=rx, scan_range_y=ry, mode=mode)
            self.scan_points.setText(str(len(self.scanner.x)))
            
            # 绘图预览
            import io
            fig, ax = plt.subplots(figsize=(4,3), dpi=80)
            ax.plot(self.scanner.abs_x, self.scanner.abs_y, 'b.-', lw=0.5, ms=2)
            ax.set_aspect('equal'); ax.grid(True)
            
            buf = io.BytesIO()
            fig.savefig(buf, format='png', bbox_inches='tight')
            plt.close(fig)
            self.lbl_scan_preview.setPixmap(QPixmap.fromImage(QImage.fromData(buf.getvalue())))
            
        except Exception as e:
            self.log_error(f"预览失败: {e}")

    def start_scan(self):
        if not self.confirm_directory(): return
        self.preview_scan_path() # 确保 scanner 最新
        if not getattr(self, 'scanner', None): return
        
        # 询问暗场
        if self.dark_frame is None:
            ans = QMessageBox.question(self, "暗场", "是否采集暗场?", QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No)
            if ans == QMessageBox.StandardButton.Yes:
                if self.camera.__class__.__name__ == "NewVSYCamera": self.camera.start_acquisition()
                self.dark_frame = self.camera.read_newest_image()
                self.log_success("暗场已采集")

        # 初始化数据缓存
        self.dp = []
        self.pos_x = []
        self.pos_y = []
        
        self.current_scan_h5_name = f"scandata.h5"
        self.scan_idx = 0
        self.scan_timer = QTimer()
        self.scan_timer.timeout.connect(self._scan_step)
        self.scan_timer.start(200) 
        self.log_info(f"开始采集 {len(self.scanner.x)} 点...")

    def _scan_step(self):
        # 1. 移动
        dx, dy = self.scanner.x[self.scan_idx], self.scanner.y[self.scan_idx]
        self.move_stage(1, dx/self.stage_widget.step_spin.value(), rel=True) # 简化调用
        
        # 2. 采集
        # VSY 特殊处理
        if self.camera and self.camera.__class__.__name__ == "NewVSYCamera":
            self.camera.start_acquisition()
            
        # 复用 save_current_frame 获取数据和 PNG
        frame_name = f"scan_{self.scan_idx:04d}"
        img_data, cx, cy = self.save_current_frame(base_name=frame_name)
        
        # 3. 存入内存列表
        if img_data is not None:
            # 扣除暗场
            if self.dark_frame is not None:
                img_f = img_data.astype(np.float32) - self.dark_frame
                img_f[img_f < 0] = 0
                self.dp.append(img_f)
            else:
                self.dp.append(img_data)
            
            self.pos_x.append(cx)
            self.pos_y.append(cy)

        self.scan_idx += 1
        
        # 4. 结束检查
        if self.scan_idx >= len(self.scanner.x):
            self.scan_timer.stop()
            self._write_scan_to_h5(self.dp, self.pos_x, self.pos_y)
            
            # 回零
            fx, fy = self.scanner.final_pos
            self.move_stage(1, -fx/self.stage_widget.step_spin.value(), rel=True)
            self.move_stage(0, -fy/self.stage_widget.step_spin.value(), rel=True)

    def _write_scan_to_h5(self, dp, px, py, path=None):
        if not path: path = os.path.join(self.save_dir, self.current_scan_h5_name)
        try:
            with h5py.File(path, 'w') as f:
                f.create_dataset("data", data=np.array(dp), compression="gzip")
                f.create_dataset("x", data=np.array(px))
                f.create_dataset("y", data=np.array(py))
                try: wl = float(self.wavelength_spin.text())
                except: wl = 632.8
                f.create_dataset("wavelength", data=np.array([wl]))
                f.attrs['timestamp'] = time.strftime('%Y-%m-%d %H:%M:%S')
            self.log_success(f"数据保存成功: {os.path.basename(path)}")
            # 清空缓存
            self.dp, self.pos_x, self.pos_y = [], [], []
        except Exception as e:
            self.log_error(f"H5保存失败: {e}")

    def save_current_frame(self, base_name=None):
        if not self.camera: return None, 0, 0
        img = self.camera.read_newest_image()
        if img is None: return None, 0, 0
        roi = self.crop_image(img)
        
        try: cx, cy = float(self.stage_widget.target_x.text()), float(self.stage_widget.target_y.text())
        except: cx, cy = 0, 0
        
        # 存图
        if not base_name: base_name = f"cap_{time.time()}"
        save_path = os.path.join(self.save_dir, base_name+".png")
        if not os.path.exists(self.save_dir): os.makedirs(self.save_dir)
        
        try:
            disp = (roi/16).astype(np.uint8) if roi.dtype==np.uint16 else roi.astype(np.uint8)
            Image.fromarray(disp).save(save_path)
        except: pass
        
        return roi, cx, cy

    def on_manual_save(self):
        name, ok = QInputDialog.getText(self, "保存", "文件名:", text=f"img_{time.strftime('%H%M%S')}")
        if ok and name:
            img, x, y = self.save_current_frame(name)
            if img is not None:
                h5_path = os.path.join(self.save_dir, name+".h5")
                # 手动保存单帧，直接构造列表传给通用函数
                self._write_scan_to_h5([img], [x], [y], h5_path)

