# =========================================================
#  1. 硬件加载线程 (使用字典映射，极简写法)
# =========================================================
class DeviceLoader(QThread):
    finished_signal = pyqtSignal(bool, object)

    def __init__(self, device_type, device_name):
        super().__init__()
        self.dt, self.dn = device_type, device_name

    def run(self):
        try:
            dev = None
            # 硬件映射表：在这里配置新设备 {名字: (模块名, 类名)}
            cam_map = {
                "IDS": ("camera", "IDS"), "Ham": ("camera", "Ham"), 
                "Lucid": ("lucid", "LucidCamera"), "PM": ("photometrics", "PyVCAM"),
                "IDS_Peak": ("peak", "IDSPeakCamera"), "PI-mte3": ("pi_camera", "PICamera"),
                "VSY": ("new_vsy_camera", "NewVSYCamera")
            }
            stage_map = {
                "NewPort": ("motion_controller", "xps"),
                "Nators": ("motion_controller", "nators"),
                "SmartAct": ("motion_controller", "smartact")
            }

            if self.dt == 'camera' and self.dn in cam_map:
                mod, cls = cam_map[self.dn]
                module = __import__(mod, fromlist=[cls])
                dev = getattr(module, cls)()
                if hasattr(dev, 'start_acquisition'): dev.start_acquisition()
                
            elif self.dt == 'stage' and self.dn in stage_map:
                mod, cls = stage_map[self.dn]
                module = __import__(mod, fromlist=[cls])
                dev = getattr(module, cls)()
                # 针对不同控制器的初始化参数
                if self.dn == "NewPort": dev.init_groups(['Group3', 'Group4'])
                elif self.dn == "Nators": dev.open_system()

            if dev: self.finished_signal.emit(True, dev)
            else: self.finished_signal.emit(False, f"未定义驱动: {self.dn}")

        except Exception as e:
            self.finished_signal.emit(False, str(e))

# =========================================================
#  2. 高性能图像显示控件 (优化绘图逻辑)
# =========================================================
class FastImageView(QGraphicsView):
    mouse_hover_signal = pyqtSignal(int, int, object)

    def __init__(self, parent=None):
        super().__init__(parent)
        self.scene = QGraphicsScene(self)
        self.setScene(self.scene)
        self.pix_item = self.scene.addPixmap(QPixmap())
        self.np_img = None
        self.setMouseTracking(True)
        self.setStyleSheet("background: #111; border: 0px;")
        
        # --- 预创建 Mask 对象 (性能优化关键) ---
        # 不再每帧创建销毁，只控制显隐
        self.v_line = self.scene.addLine(0,0,0,0, QPen(QColor("red"), 1, Qt.PenStyle.DashLine))
        self.h_line = self.scene.addLine(0,0,0,0, QPen(QColor("blue"), 1, Qt.PenStyle.DashLine))
        self.circle = self.scene.addEllipse(0,0,0,0, QPen(QColor("green"), 2))
        
        for item in [self.v_line, self.h_line, self.circle]:
            item.setZValue(10)     # 永远在顶层
            item.setVisible(False) # 默认隐藏

    def update_image(self, img_data, show_mask=False):
        self.np_img = img_data
        h, w = img_data.shape
        
        # 1. 快速转换 (避免不必要的拷贝)
        if img_data.dtype == np.uint16:
            # 简单降位，速度最快
            disp_data = (img_data >> 4).astype(np.uint8) if img_data.max() > 4095 else img_data.astype(np.uint8)
        else:
            disp_data = img_data.astype(np.uint8)

        # 2. 更新图像
        qimg = QImage(disp_data.data, w, h, w, QImage.Format.Format_Grayscale8)
        self.pix_item.setPixmap(QPixmap.fromImage(qimg))

        # 3. 更新 Mask (仅更新坐标，不创建对象)
        if show_mask:
            cx, cy = w / 2, h / 2
            r = min(w, h) / 4
            self.v_line.setLine(cx, 0, cx, h)
            self.h_line.setLine(0, cy, w, cy)
            self.circle.setRect(cx-r, cy-r, r*2, r*2)
            
        # 4. 统一设置可见性
        for item in [self.v_line, self.h_line, self.circle]:
            item.setVisible(show_mask)

        self.fitInView(self.pix_item, Qt.AspectRatioMode.KeepAspectRatio)

    def mouseMoveEvent(self, event):
        if self.np_img is not None:
            sp = self.mapToScene(event.pos())
            x, y = int(sp.x()), int(sp.y())
            h, w = self.np_img.shape
            if 0 <= x < w and 0 <= y < h:
                self.mouse_hover_signal.emit(x, y, self.np_img[y, x])
                return
        self.mouse_hover_signal.emit(-1, -1, None)
        super().mouseMoveEvent(event)

# =========================================================
#  3. 主逻辑 (精简版)
# =========================================================
class LogicWindow(ModernUI):
    def __init__(self):
        super().__init__()
        sys.excepthook = self.handle_exception
        
        # 替换 UI 里的 Label 为图像控件
        self.image_view = FastImageView()
        if self.image_area.layout(): 
            QWidget().setLayout(self.image_area.layout()) # 清除旧 layout
        layout = QVBoxLayout(self.image_area)
        layout.setContentsMargins(0,0,0,0)
        layout.addWidget(self.image_view)

        # 核心变量
        self.camera = None
        self.motion = None
        self.scan_buffer = {'dp': [], 'x': [], 'y': []}
        self.save_dir = "D:/Data" # 默认路径简化
        self.save_dir_edit.setText(self.save_dir)
        self.dark_frame = None

        # 定时器
        self.timer = QTimer()
        self.timer.timeout.connect(self.update_frame)

        # 信号绑定
        self.bind_signals()

    def bind_signals(self):
        # 硬件
        self.btn_open_cam.clicked.connect(lambda: self.load_device('camera'))
        self.btn_connect_stage.clicked.connect(lambda: self.load_device('stage'))
        
        # 操作
        self.btn_live.clicked.connect(self.toggle_live)
        self.btn_cap.clicked.connect(self.start_scan)
        self.btn_save.clicked.connect(self.manual_save)
        self.btn_browse.clicked.connect(self.select_folder)
        self.btn_show_path.clicked.connect(self.preview_path)
        self.btn_center.clicked.connect(self.auto_center)
        self.exposure_spin.valueChanged.connect(self.update_exposure)

        # 位移台
        w = self.stage_widget
        w.btn_up.clicked.connect(lambda: self.move_stage(0, 1, rel=True))
        w.btn_down.clicked.connect(lambda: self.move_stage(0, -1, rel=True))
        w.btn_left.clicked.connect(lambda: self.move_stage(1, -1, rel=True))
        w.btn_right.clicked.connect(lambda: self.move_stage(1, 1, rel=True))
        w.btn_go.clicked.connect(lambda: self.move_stage(0, 0, rel=False))
        w.btn_zero.clicked.connect(self.zero_stage)

        self.image_view.mouse_hover_signal.connect(self.on_mouse_hover)

    # --- 日志系统 (HTML 格式) ---
    def log(self, msg, color="#2196F3"):
        t = time.strftime("%H:%M:%S")
        self.txt_log.append(f"<span style='color:{color}'><b>[{t}]</b> {msg}</span>")
        self.txt_log.verticalScrollBar().setValue(self.txt_log.verticalScrollBar().maximum())

    def handle_exception(self, etype, evalue, tb):
        err = "".join(traceback.format_exception(etype, evalue, tb))
        print(err)
        self.log(f"系统错误: {evalue}", "#F44336")

    # --- 硬件加载通用逻辑 ---
    def load_device(self, dtype):
        name = self.combo_camera.currentText() if dtype == 'camera' else self.combo_stage.currentText()
        btn = self.btn_open_cam if dtype == 'camera' else self.btn_connect_stage
        
        self.log(f"正在加载 {dtype}: {name}...")
        btn.setEnabled(False)
        
        self.loader = DeviceLoader(dtype, name)
        self.loader.finished_signal.connect(lambda s, r: self.on_loaded(dtype, s, r, btn))
        self.loader.start()

    def on_loaded(self, dtype, success, result, btn):
        btn.setEnabled(True)
        if not success:
            self.log(f"加载失败: {result}", "red")
            return
            
        if dtype == 'camera':
            self.camera = result
            self.update_exposure()
            # 获取位深用于计算饱和
            self.bit_depth = getattr(result, 'bit_depth', 16)
            self.sat_val = (1 << self.bit_depth) - 1
            btn.setStyleSheet("background:#4CAF50;color:white;")
            self.log(f"相机就绪 ({self.bit_depth}-bit)", "green")
        else:
            self.motion = result
            self.sync_pos()
            btn.setText("已连接")
            self.log("位移台就绪", "green")

    # --- 图像刷新 (核心循环) ---
    def update_frame(self):
        if not self.camera: return
        try:
            # 1. 采集 & 裁剪
            img = self.camera.read_newest_image()
            if img is None: return
            
            roi = self.crop_image(img)
            
            # 2. 统计信息 (最大值)
            gmax = np.max(roi)
            self.line_global_max.setText(str(gmax))
            style = "color:red;background:#fee;" if gmax >= self.sat_val else "color:green;background:#eee;"
            self.line_global_max.setStyleSheet(style + "font-weight:bold;")

            # 3. 显示 (Log 变换只在勾选时运算，节省 CPU)
            if self.chk_log.isChecked():
                # 转换 float32 运算 -> log -> 归一化
                img_f = roi.astype(np.float32)
                disp = (np.log1p(img_f) / np.log1p(self.sat_val) * self.sat_val).astype(np.uint16)
                self.image_view.update_image(disp, self.chk_mask.isChecked())
            else:
                self.image_view.update_image(roi, self.chk_mask.isChecked())
                
        except Exception as e:
            pass # 实时流报错不弹窗，避免卡死

    def crop_image(self, img):
        # 极简裁剪逻辑，含越界保护
        h, w = img.shape
        try:
            tw, th = int(self.roi_w.text()), int(self.roi_h.text())
            ox, oy = int(self.off_x.text()), int(self.off_y.text())
        except: tw, th, ox, oy = 1024, 1024, 0, 0
        
        cx, cy = w//2 + ox, h//2 + oy
        x1, y1 = max(0, cx - tw//2), max(0, cy - th//2)
        x2, y2 = min(w, x1 + tw), min(h, y1 + th)
        return img[int(y1):int(y2), int(x1):int(x2)]

    # --- 功能函数 ---
    def toggle_live(self):
        if not self.camera: return
        if self.timer.isActive():
            self.timer.stop()
            self.btn_live.setText("👁 启动")
            self.btn_live.setStyleSheet("background:#27ae60;color:white;font-weight:bold;")
        else:
            self.timer.start(50) # 20fps
            self.btn_live.setText("⬛ 停止")
            self.btn_live.setStyleSheet("background:#7f8c8d;color:white;font-weight:bold;")

    def update_exposure(self):
        if self.camera: self.camera.set_ex_time(self.exposure_spin.value()/1000.0)

    def on_mouse_hover(self, x, y, val):
        if val is not None:
            self.line_mouse_val.setText(str(val))

    def auto_center(self):
        if not self.camera: return
        img = self.camera.read_newest_image()
        if img is None: return
        
        # 简单质心算法
        mask = img > (np.mean(img) + 3*np.std(img))
        if np.sum(mask) == 0: 
            self.log("图像太暗，无法对准", "orange")
            return
            
        y_idx, x_idx = np.indices(img.shape)
        total = np.sum(img[mask])
        cx = np.sum(x_idx[mask] * img[mask]) / total
        cy = np.sum(y_idx[mask] * img[mask]) / total
        
        h, w = img.shape
        self.off_x.setText(str(int(cx - w/2)))
        self.off_y.setText(str(int(cy - h/2)))
        self.log(f"自动对准完成: Offset ({self.off_x.text()}, {self.off_y.text()})", "green")
        self.update_frame()

    # --- 位移台控制 (合并逻辑) ---
    def move_stage(self, logical_axis, val, rel=True):
        """
        logical_axis: 0=Up/Down(Y), 1=Left/Right(X)  (注意这里为了摇杆方便，定义略有不同)
        val: 步进方向 或者 绝对坐标值
        rel: 是否相对移动
        """
        if not self.motion: return
        
        # 1. 读取配置
        w = self.stage_widget
        swap = w.check_swap.isChecked()
        inv = [w.check_inv_y.isChecked(), w.check_inv_x.isChecked()] # [Y, X]
        
        # 2. 计算物理移动量
        try:
            if rel:
                # 相对移动 (摇杆)
                step = w.step_spin.value()
                delta = [0, 0]
                # logical_axis 0->Y, 1->X
                idx = 0 if logical_axis == 0 else 1
                dist = val * step
                if inv[idx]: dist *= -1
                
                # 物理轴映射
                phys_axis = 1 if (idx==0 and not swap) or (idx==1 and swap) else 0
                self.motion.move_by(dist, axis=phys_axis)
            else:
                # 绝对移动
                tx, ty = float(w.target_x.text()), float(w.target_y.text())
                # 简单处理：如果有 move_to 最好，没有则算差值
                if hasattr(self.motion, 'move_to'):
                    ax_x = 1 if swap else 0
                    ax_y = 0 if swap else 1
                    self.motion.move_to(tx, axis=ax_x)
                    self.motion.move_to(ty, axis=ax_y)
                else:
                    self.log("驱动不支持绝对移动", "orange")
            
            self.sync_pos()
            
        except Exception as e:
            self.log(f"移动失败: {e}", "red")

    def sync_pos(self):
        if not self.motion: return
        try:
            # 兼容不同接口
            if hasattr(self.motion, 'get_position'):
                x, y = self.motion.get_position(0), self.motion.get_position(1)
            else:
                x, y = 0, 0 # fallback
                
            self.stage_widget.lbl_x.setText(f"X: {x:.3f}")
            self.stage_widget.lbl_y.setText(f"Y: {y:.3f}")
            
        except: pass

    def zero_stage(self):
        if self.motion and hasattr(self.motion, 'move_to'):
            self.motion.move_to(0,0); self.motion.move_to(0,1)
            self.sync_pos()
            self.log("已回零", "blue")

    # --- 扫描与保存 ---
    def select_folder(self):
        d = QFileDialog.getExistingDirectory(self, "选择保存路径")
        if d: 
            self.save_dir = d
            self.save_dir_edit.setText(d)

    def preview_path(self):
        try:
            from Scanner import Scanner
            mode_map = {"矩形": "rectangle", "圆形": "round", "螺旋": "fermat"}
            mode = mode_map.get(self.combo_scan_mode.currentText(), "round")
            
            rx, ry = float(self.scan_range_x.text()), float(self.scan_range_y.text())
            step = float(self.scan_step.text())
            
            self.scanner = Scanner(step=step, scan_range_x=rx, scan_range_y=ry, mode=mode)
            self.scan_points.setText(str(len(self.scanner.x)))
            
            # 绘图预览
            import matplotlib.pyplot as plt
            import io
            fig, ax = plt.subplots(figsize=(4,3), dpi=80)
            ax.plot(self.scanner.abs_x, self.scanner.abs_y, 'b.-', lw=0.5, ms=2)
            ax.set_aspect('equal'); ax.grid(True)
            
            buf = io.BytesIO()
            fig.savefig(buf, format='png', bbox_inches='tight')
            plt.close(fig)
            self.lbl_scan_preview.setPixmap(QPixmap.fromImage(QImage.fromData(buf.getvalue())))
            
        except Exception as e:
            self.log(f"预览失败: {e}", "red")

    def start_scan(self):
        if not getattr(self, 'scanner', None):
            self.log("请先生成扫描路径", "orange"); return
        
        # 初始化
        self.scan_buffer = {'dp': [], 'x': [], 'y': []}
        self.scan_idx = 0
        self.scan_timer = QTimer()
        self.scan_timer.timeout.connect(self.scan_step)
        self.scan_timer.start(200) # 采集间隔
        self.log(f"开始采集 {len(self.scanner.x)} 点...", "blue")

    def scan_step(self):
        # 1. 移动
        dx, dy = self.scanner.x[self.scan_idx], self.scanner.y[self.scan_idx]
        self.move_stage(1, dx/self.stage_widget.step_spin.value(), rel=True) # 复用逻辑需小心，这里简化处理直接调用驱动更好
        if self.motion:
            # 直接调用物理移动更稳
            self.motion.move_by(dx, axis=0); self.motion.move_by(dy, axis=1)

        # 2. 存图
        img = self.camera.read_newest_image()
        roi = self.crop_image(img) if img is not None else np.zeros((100,100))
        
        # 存入 Buffer
        self.scan_buffer['dp'].append(roi)
        self.scan_buffer['x'].append(float(self.stage_widget.target_x.text() or 0))
        self.scan_buffer['y'].append(float(self.stage_widget.target_y.text() or 0))
        
        # 3. 进度检查
        self.scan_idx += 1
        if self.scan_idx >= len(self.scanner.x):
            self.scan_timer.stop()
            self.save_h5_file()

    def save_h5_file(self, filename=None):
        if not filename:
            name = f"Scan_{self.combo_scan_mode.currentText()}_{time.strftime('%H%M%S')}.h5"
            filename = os.path.join(self.save_dir, name)
            
        try:
            with h5py.File(filename, 'w') as f:
                grp = f.create_group("scan_data")
                # 关键：转 Numpy 再存，支持压缩
                grp.create_dataset("data", data=np.array(self.scan_buffer['dp']), compression="gzip")
                grp.create_group("position").create_dataset("x", data=np.array(self.scan_buffer['x']))
                grp.create_group("position").create_dataset("y", data=np.array(self.scan_buffer['y']))
                grp.attrs['timestamp'] = time.strftime('%Y-%m-%d %H:%M:%S')
                
            self.log(f"保存成功: {os.path.basename(filename)}", "green")
            # 清空内存
            self.scan_buffer = {'dp': [], 'x': [], 'y': []}
            
        except Exception as e:
            self.log(f"保存失败: {e}", "red")

    def manual_save(self):
        name, ok = QInputDialog.getText(self, "保存", "文件名:", text=f"img_{time.strftime('%H%M%S')}")
        if ok and name:
            # 存 PNG
            img = self.camera.read_newest_image()
            if img is not None:
                roi = self.crop_image(img)
                Image.fromarray((roi/16).astype(np.uint8)).save(os.path.join(self.save_dir, name+".png"))
                
                # 存 H5 (单帧)
                self.scan_buffer = {'dp': [roi], 'x': [0], 'y': [0]}
                self.save_h5_file(os.path.join(self.save_dir, name+".h5"))

if __name__ == '__main__':
    app = QApplication(sys.argv)
