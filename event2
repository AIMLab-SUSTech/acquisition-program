# =========================================================
#  1. 硬件加载线程 (使用字典映射，极简写法)
# =========================================================
class DeviceLoader(QThread):
    finished_signal = pyqtSignal(bool, object)

    def __init__(self, device_type, device_name):
        super().__init__()
        self.dt, self.dn = device_type, device_name

    def run(self):
        try:
            dev = None
            # 硬件映射表：在这里配置新设备 {名字: (模块名, 类名)}
            # 格式: "UI显示的名称": ("文件名", "类名")
            cam_map = {
                "IDS": ("camera", "IDS"), 
                "Ham": ("camera", "Ham"), 
                "Lucid": ("lucid", "LucidCamera"), 
                "PM": ("photometrics", "PyVCAM"),
                "IDS_Peak": ("peak", "IDSPeakCamera"), 
                "PI-mte3": ("pi_camera", "PICamera"),
                "VSY": ("new_vsy_camera", "NewVSYCamera")
            }
            stage_map = {
                "NewPort": ("motion_controller", "xps"),
                "Nators": ("motion_controller", "nators"),
                "SmartAct": ("motion_controller", "smartact")
            }

            if self.dt == 'camera' and self.dn in cam_map:
                mod_name, cls_name = cam_map[self.dn]
                module = __import__(mod_name, fromlist=[cls_name])
                cls = getattr(module, cls_name) # 先获取类，不直接实例化

                # 1. 根据不同相机类型进行实例化
                if self.dn == "Lucid":
                    # Lucid 需要特殊参数，单独实例化
                    dev = cls(max_tries=1, wait_time=1)
                else:
                    # 其他相机通常是无参初始化
                    dev = cls()

                # 2. 初始化后的特定设置 (如 IDS 设置像素率)
                if self.dn == "IDS":
                    # 确保类中有这个方法再调用，或者直接调用
                    if hasattr(dev, 'set_pixel_rate'):
                        dev.set_pixel_rate(7e7)

                # 3. 统一启动采集 (VSY 除外)
                if hasattr(dev, 'start_acquisition') and self.dn != "VSY": 
                    dev.start_acquisition()
                
            elif self.dt == 'stage' and self.dn in stage_map:
                mod_name, cls_name = stage_map[self.dn]
                module = __import__(mod_name, fromlist=[cls_name])
                # 针对不同控制器的初始化参数
                if self.dn == "NewPort": 
                    dev = getattr(module, cls_name)(IP='192.168.0.254')
                    dev.init_groups(['Group3', 'Group4'])
                elif self.dn == "Nators": 
                    dev = getattr(module, cls_name)(ip_address="192.168.0.254")
                    dev.open_system()
                else:
                    dev = getattr(module, cls_name)()

            if dev: self.finished_signal.emit(True, dev)
            else: self.finished_signal.emit(False, f"未定义驱动: {self.dn}")

        except Exception as e:
            self.finished_signal.emit(False, str(e))

# =========================================================
#  2. 高性能图像显示控件 (优化绘图逻辑，老电脑友好)
# =========================================================
class FastImageView(QGraphicsView):
    mouse_hover_signal = pyqtSignal(int, int, object)

    def __init__(self, parent=None):
        super().__init__(parent)
        self.scene = QGraphicsScene(self)
        self.setScene(self.scene)
        self.pix_item = self.scene.addPixmap(QPixmap())
        self.np_img = None
        self.setMouseTracking(True)
        self.setStyleSheet("background: #111; border: 0px;")
        
        # --- 预创建 Mask 对象 (性能优化关键) ---
        # 不再每帧创建销毁，只控制显隐
        self.v_line = self.scene.addLine(0,0,0,0, QPen(QColor("red"), 1, Qt.PenStyle.DashLine))
        self.h_line = self.scene.addLine(0,0,0,0, QPen(QColor("blue"), 1, Qt.PenStyle.DashLine))
        self.circle = self.scene.addEllipse(0,0,0,0, QPen(QColor("green"), 2))
        
        # 默认隐藏所有 Mask 元素
        for item in [self.v_line, self.h_line, self.circle]:
            item.setZValue(10)     # 永远在顶层
            item.setVisible(False) 

    def update_image(self, img_data, show_mask=False):
        self.np_img = img_data
        h, w = img_data.shape
        
        # 1. 快速转换 (避免不必要的拷贝)
        if img_data.dtype == np.uint16:
            # 简单降位显示，速度最快
            disp_data = (img_data >> 4).astype(np.uint8) if img_data.max() > 4095 else img_data.astype(np.uint8)
        else:
            disp_data = img_data.astype(np.uint8)

        # 2. 更新图像
        qimg = QImage(disp_data.data, w, h, w, QImage.Format.Format_Grayscale8)
        self.pix_item.setPixmap(QPixmap.fromImage(qimg))

        # 3. 更新 Mask (仅更新坐标，不创建对象)
        if show_mask:
            cx, cy = w / 2, h / 2
            r = min(w, h) / 4
            self.v_line.setLine(cx, 0, cx, h)
            self.h_line.setLine(0, cy, w, cy)
            self.circle.setRect(cx-r, cy-r, r*2, r*2)
            
        # 4. 统一设置可见性
        for item in [self.v_line, self.h_line, self.circle]:
            item.setVisible(show_mask)

        self.fitInView(self.pix_item, Qt.AspectRatioMode.KeepAspectRatio)

    def mouseMoveEvent(self, event):
        if self.np_img is not None:
            sp = self.mapToScene(event.pos())
            x, y = int(sp.x()), int(sp.y())
            h, w = self.np_img.shape
            if 0 <= x < w and 0 <= y < h:
                self.mouse_hover_signal.emit(x, y, self.np_img[y, x])
                return
        self.mouse_hover_signal.emit(-1, -1, None)
        super().mouseMoveEvent(event)

